<h1>Update Quantity</h1>

<%= form_with url: '/goods/update_quantity', method: :post, local: true do |f| %>
  <div>
    <%= f.label :name, "Product Name" %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :action_type, "Action" %>
    <%= f.select :action_type, options_for_select([['Add', 'add'], ['Remove', 'remove']]) %>
  </div>
  <div>
    <%= f.label :amount, "Amount" %>
    <%= f.number_field :amount %>
  </div>
  <div>
    <%= f.submit "Update Quantity" %>
  </div>
<% end %>
